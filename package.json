{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:vercel": "node scripts/next-runtime.mjs build --webpack",
    "dev:vercel": "node scripts/next-runtime.mjs dev --webpack",
    "start:vercel": "node scripts/next-runtime.mjs start",
    "db:migrate:neon": "node --env-file=.env.local scripts/migrate-postgres.mjs",
    "db:migrate:activity:neon": "node --env-file=.env.local scripts/migrate-activity-postgres.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "check:release": "node scripts/check.mjs",
    "companion:build": "node scripts/build-companion.mjs",
    "companion:start": "node companion/bridge.mjs",
    "companion:package": "node scripts/package-companion.mjs",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@base-ui/react": "1.7.0",
    "@neondatabase/auth": "^0.5.0-beta",
    "@neondatabase/auth-ui": "^0.3.0-beta",
    "@shadcn/react": "0.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.9",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "stripe": "^22.6.2",
    "tailwind-merge": "3.6.0",
    "three": "^0.186.1",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@cloudflare/workers-types": "5.20260918.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "wrangler": "4.135.0"
  },
  "type": "module",
  "overrides": {
    "image-size": "2.0.4",
    "undici": "7.29.1"
