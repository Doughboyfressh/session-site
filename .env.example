# Server-only values. Keep the token out of browser code and source control.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Optional — card payments (leave unset for "payments coming soon" mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FEE_BPS=0

# Vercel + Neon target. Use .env.local for local checks and encrypted Vercel
# production variables when deploying. Do not prefix secrets with NEXT_PUBLIC_.
DEPLOYMENT_TARGET=vercel
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-1
SESSION_FILES_BUCKET=session-files
APP_URL=
